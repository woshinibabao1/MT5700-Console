#!/bin/sh

# 首次安装时确保默认配置存在（config 文件已随包分发，这里做防御性初始化）
uci -q get at-webserver.config >/dev/null || {
	uci -q set at-webserver.config=config
	uci -q commit at-webserver
}

# 确保日志目录存在
mkdir -p /tmp

# 复位命令默认值：先重拉 MT5700M 接口（纯 shell，不碰模组协议栈）
DEF_RESET_CMDS='ifdown MT5700M\nsleep 2\nifup MT5700M'
# 连通性探测目标默认值：腾讯 DNS / DNSPod（公网 IP，回 ICMP）
DEF_WATCH_GATEWAY='119.29.29.29'
# v1.0 随包发出的旧默认值（本次要迁移掉，见下方说明）
LEGACY_RESET_CMDS='AT+CFUN=1,1'

# 老版本升级上来的配置里没有看门狗选项：补齐默认值（仅补缺失项，不覆盖用户设置）。
# 注意：下面这段是带 \ 续行的词表，中间不能插注释——续行会把 # 吞进词里。
# watch_reset_cmds 的值含空格，必须加引号；单引号内 \n 保持字面量（UCI 多行就是这么存的，
# watchdog.sh 只翻译 \n、service.js 用 replace(/\\n/g) 还原）。
for kv in \
	watch_enabled=1 \
	watch_iface=MT5700M \
	watch_device=eth2 \
	watch_gateway="$DEF_WATCH_GATEWAY" \
	watch_interval=60 \
	watch_fail_threshold=3 \
	watch_reset_modem=0 \
	watch_reset_cmds="$DEF_RESET_CMDS" \
	read_cache_ttl=0 \
	read_cache_static_ttl=300 \
	sms_auto_clean=1
do
	key=${kv%%=*}
	val=${kv#*=}
	uci -q get "at-webserver.config.$key" >/dev/null || uci -q set "at-webserver.config.$key=$val"
done

# ---------------------------------------------------------------------------
# v1.0 → v1.0.1 迁移：把「随包发出的旧默认值」换成新默认值
# ---------------------------------------------------------------------------
# 为什么必须迁移 watch_reset_cmds：
#   v1.0 的 AT 下发通道是坏的（用 wget 打 HTTP，而 8765 是裸 TCP newline-JSON），
#   所以旧默认值 AT+CFUN=1,1 一直是**空转**的——看着配了，其实一条都没下发。
#   v1.0.1 把通道修好之后，这个残留值会**真的**去复位模组协议栈，进而让 eth2
#   数据面挂死。所以必须把它换成安全的「重拉接口」，不能留着。
# 只在「值恰好等于我们旧版随包默认值」时才改，用户自己填过的内容一律不动。
# （判据是「等于旧默认值」，不是「非空」——避免覆盖用户的真实自定义。）
_cur_cmds=$(uci -q get at-webserver.config.watch_reset_cmds)
if [ "$_cur_cmds" = "$LEGACY_RESET_CMDS" ]; then
	uci -q set "at-webserver.config.watch_reset_cmds=$DEF_RESET_CMDS"
	logger -t mt5700-uci "watch_reset_cmds 由旧默认 AT+CFUN=1,1 迁移为「重拉 MT5700M 接口」（通道已修好，旧值现在会真的复位协议栈）"
fi

# 看门狗默认开启：它只做 DHCP 续约，不动模组、不断网，风险极低，
# 而它要防的「模组在、路由器在、就是没网」恰恰是用户完全无从下手的故障。
# 同样只在「等于旧版随包默认值 0」时才改。
_cur_en=$(uci -q get at-webserver.config.watch_enabled)
if [ "$_cur_en" = "0" ]; then
	uci -q set at-webserver.config.watch_enabled=1
fi

uci -q commit at-webserver

# 关键脚本可执行（包管理器偶发丢失 +x）
chmod 0755 /usr/share/mt5700/watchdog.sh 2>/dev/null
chmod 0755 /etc/hotplug.d/net/99-mt5700-renew 2>/dev/null
chmod 0755 /etc/init.d/mt5700-watchdog 2>/dev/null
chmod 0755 /etc/init.d/at-webserver 2>/dev/null

# ---------------------------------------------------------------------------
# AT 服务开机自启
# ---------------------------------------------------------------------------
# 真机故障（2026-09-15）：固件里 /etc/rc.d/S99at-webserver 链接是存在的（构建时
# 已 enable），但 /etc/init.d/at-webserver **没有可执行位** —— 该文件在 git 里
# 是 100644。rc 序列调用它时直接 `Permission denied`，于是每次开机都起不来，
# 只能手动 `sh /etc/init.d/at-webserver start` 救场。
# 根因修复：仓库里已把该文件标成 100755。这里是运行时兜底 —— 老固件/手工拷贝
# 部署仍可能丢 +x，补一次再 enable，避免同一故障换个环境复发。
if [ -x /etc/init.d/at-webserver ]; then
	/etc/init.d/at-webserver enable 2>/dev/null
	logger -t mt5700-uci "at-webserver 已设为开机自启（S99at-webserver）"
else
	logger -t mt5700-uci "警告：/etc/init.d/at-webserver 不存在或不可执行，开机将无法自启"
fi

# 安装场景（opkg/apk 直接装包）没有 rc 序列，这里显式拉起一次。
# 开机场景由 S99 负责；start_service 内部有「已在运行则跳过」保护，
# 两条路径撞上也不会起第二个实例。延迟 5s 是为了避开 boot 早期的串口枚举。
( sleep 5; [ -x /etc/init.d/at-webserver ] && /etc/init.d/at-webserver start ) >/dev/null 2>&1 &

# 让 hotplug 与看门狗在本次安装后立即生效（无需重启）
[ -x /etc/init.d/mt5700-watchdog ] && /etc/init.d/mt5700-watchdog enable 2>/dev/null
[ -x /etc/init.d/mt5700-watchdog ] && /etc/init.d/mt5700-watchdog start 2>/dev/null

exit 0
