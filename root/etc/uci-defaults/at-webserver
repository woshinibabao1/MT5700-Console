#!/bin/sh

# 首次安装时确保默认配置存在（config 文件已随包分发，这里做防御性初始化）
uci -q get at-webserver.config >/dev/null || {
	uci -q set at-webserver.config=config
	uci -q commit at-webserver
}

# 确保日志目录存在
mkdir -p /tmp

# 老版本升级上来的配置里可能缺项：补齐默认值（仅补缺失项，不覆盖用户设置）。
# 注意：下面这段是带 \ 续行的词表，中间不能插注释——续行会把 # 吞进词里。
for kv in \
	read_cache_ttl=0 \
	read_cache_static_ttl=300 \
	sms_auto_clean=1
do
	key=${kv%%=*}
	val=${kv#*=}
	uci -q get "at-webserver.config.$key" >/dev/null || uci -q set "at-webserver.config.$key=$val"
done

uci -q commit at-webserver

# 关键脚本可执行（包管理器偶发丢失 +x）
chmod 0755 /etc/hotplug.d/net/99-mt5700-renew 2>/dev/null
chmod 0755 /etc/init.d/at-webserver 2>/dev/null

# ---------------------------------------------------------------------------
# 全局统一 TTL：登记 nftables include + 预生成规则文件
# ---------------------------------------------------------------------------
# ★ 必须是 type='nftables'。fw4（nftables 版防火墙）的 include **只认 nftables**，
#   script 类型在 fw4 下根本不会被执行 —— 那是 fw3/iptables 时代的能力。
#   实测踩过：先写成 /etc/firewall.d/ 的 shell 脚本 + type=script，登记后
#   reload 防火墙，规则数是 0，而 uci show 里一切正常。
# ★ 不写 family / reload：这两个选项对 include 是 UNSUPPORTED（见 fw4.uc 的
#   parse_include 选项表），写了不报错但也毫无作用，只会让后来的人以为它们在起作用。
# ★ 不指定 position：默认 table-append（插在 table inet fw4 内部末尾），
#   而规则文件里写的是 `chain srcnat { … }` —— 只有在 table 内部才能声明 chain。
#   改成 ruleset-append 会让那段语法失败，进而**整次防火墙重载失败**。
mkdir -p /etc/mt5700 2>/dev/null
if [ ! -f /etc/mt5700/ttl.nft ]; then
	cat > /etc/mt5700/ttl.nft <<'TTLEOF'
# MT5700 Console 全局统一 TTL
# 本文件由 mt5700.ttl RPC 生成，手改会在下次保存设置时被覆盖。
# 当前已关闭：刻意保留空规则，避免 fw4 每次重载报 unreachable path。
TTLEOF
fi

# 幂等：老版本可能已登记过（或用户手工删了配置），用 `uci -q get` 判存在，
# 不存在才整节创建；已存在则只校正字段，不重复追加节。
if uci -q get firewall.mt5700_ttl >/dev/null 2>&1; then
	uci set firewall.mt5700_ttl.type='nftables'
	uci set firewall.mt5700_ttl.path='/etc/mt5700/ttl.nft'
else
	uci set firewall.mt5700_ttl=include
	uci set firewall.mt5700_ttl.type='nftables'
	uci set firewall.mt5700_ttl.path='/etc/mt5700/ttl.nft'
fi
# 早期版本写过这两个无效选项，清掉
uci -q delete firewall.mt5700_ttl.family
uci -q delete firewall.mt5700_ttl.reload
uci commit firewall

# 补齐 TTL 默认值（仅补缺失，不覆盖用户已有设置）
uci -q get at-webserver.config.ttl_enabled >/dev/null || uci -q set at-webserver.config.ttl_enabled='0'
uci -q get at-webserver.config.ttl_value >/dev/null || uci -q set at-webserver.config.ttl_value='128'
uci commit at-webserver

# ---------------------------------------------------------------------------
# 运行时兜底：timeout 命令（2026-10-07 真机故障，MWRT r33382 / kernel 6.6.94）
# ---------------------------------------------------------------------------
# rpcd ucode 插件（/usr/share/rpcd/ucode/mt5700.uc）的 6 处调用都用
# `timeout N ...` 拿回环 RPC / curl / nslookup / 诊断探针：
#     p = fs.popen('timeout 45 nc 127.0.0.1 8765 < tmp', 'r');   ← 第 356 行 rpcCall
# 部分固件的 busybox 不含 timeout applet（MWRT 实测：busybox timeout →
# "applet not found"、/bin/sh → "timeout: not found"、PATH 里也没有），
# 于是 shell 直接 127 退出、一行输出都没有，ucode 侧读到的 line 为空，
# 统一报成「Rust 后端无应答（已限时 45 秒）」—— **该文案是假的**，实测耗时 0.00s。
#
# 后果不是降级而是全废：所有 AT 读取失败，整个 /admin/modem/5g 页面读不到任何信息，
# 同时 exitip / sysdiag / DoH / ePDG 一起失效。
# ★ 该固件上 AT 通道本身完全正常（直连 nc 8765 连续 5 次成功、通知日志有真实
#   RSRP/频点），所以任何"重启服务""换串口"都是白费力气，务必先查 timeout 在不在。
#
# 为什么不在 Makefile 的 LUCI_DEPENDS 里声明 coreutils-timeout：
#   与文件头"netcat 不设硬依赖"是同一条理由 —— 目标源缺同名包时，硬依赖会让
#   opkg 直接安装失败，得不偿失。缺失是可诊断的（只需 command -v timeout）。
# coreutils-timeout 仅 20KB，Depends 只有 libc/coreutils/librt（coreutils 本体
#   常已随固件存在），代价可忽略，值得在缺时补装而不是让整个包装不上。
if ! command -v timeout >/dev/null 2>&1; then
	logger -t mt5700-uci "缺少 timeout 命令（ucode 代理的 6 处调用都依赖它），正在补装 coreutils-timeout"
	# opkg 优先；apk 系（OpenWrt 24.10+ / MWRT）两者都可能存在，都试一遍。
	# 装不上也不阻塞安装流程 —— 下面的告警已经足够定位。
	# ★ 限时（2026-10-22 审计）：feed 不可达时 opkg 会重试很久，把包管理器整个
	#   拖住数分钟。系统此刻没有 timeout 可用（正在补装的就是它），用
	#   「后台起子进程 + sleep 上限 + kill」手搓限时；装不上也不阻塞安装。
	(
		opkg install coreutils-timeout ||
			apk add --no-cache coreutils-timeout
	) >/dev/null 2>&1 &
	_install_pid=$!
	(
		sleep 60
		kill "$_install_pid" 2>/dev/null
	) >/dev/null 2>&1 &
	_watchdog_pid=$!
	wait "$_install_pid" 2>/dev/null
	kill "$_watchdog_pid" 2>/dev/null
	if command -v timeout >/dev/null 2>&1; then
		logger -t mt5700-uci "coreutils-timeout 安装成功，AT 通道可用"
	else
		logger -t mt5700-uci "警告：coreutils-timeout 安装失败，AT 通道将全部报「无应答」。请手动 opkg install coreutils-timeout"
	fi
fi

# ---------------------------------------------------------------------------
# AT 服务开机自启
# ---------------------------------------------------------------------------
# 真机故障（2026-09-15）：固件里 /etc/rc.d/S99at-webserver 链接是存在的（构建时
# 已 enable），但 /etc/init.d/at-webserver **没有可执行位** —— 该文件在 git 里
# 是 100644。rc 序列调用它时直接 `Permission denied`，于是每次开机都起不来，
# 只能手动 `sh /etc/init.d/at-webserver start` 救场。
# 根因修复：仓库里已把该文件标成 100755。这里是运行时兜底 —— 老固件/手工拷贝
# 部署仍可能丢 +x，补一次再 enable，避免同一故障换个环境复发。
# ★ 2026-10-22 审计（B15 部分）：/etc/config/at-webserver 里有 websocket_auth_key
# 与企微 webhook，收掉组/其他位 —— 包安装出来的文件权限取决于打包宏，这里统一兜底。
[ -f /etc/config/at-webserver ] && chmod 0600 /etc/config/at-webserver 2>/dev/null

if [ -x /etc/init.d/at-webserver ]; then
	/etc/init.d/at-webserver enable 2>/dev/null
	logger -t mt5700-uci "at-webserver 已设为开机自启（S99at-webserver）"
else
	logger -t mt5700-uci "警告：/etc/init.d/at-webserver 不存在或不可执行，开机将无法自启"
fi

# 安装场景（opkg/apk 直接装包）没有 rc 序列，这里显式拉起一次。
# 开机场景由 S99 负责；安装场景下服务通常还没起来，这里补一次即可。
# 注意：对 procd 托管的服务，start 天然是「重新注册 + 重启实例」，
# 不存在「已在运行则跳过」这条路（rc.common 会先把实例表清空），
# 所以两条路径同时触发时会看到一次正常的实例切换，属于预期行为。
# 延迟 5s 是为了避开 boot 早期的串口枚举。
#
# 先 ensure_interfaces 再 start：
#   ensure_interfaces 只对齐模组接口与防火墙 wan 区（幂等、不碰后端进程），
#   修的正是存量设备最常见的那种「接口早就存在、只是没进 wan 区 → 有信号却上不了网」。
#   放到后台跑，避免 ifup 等待把包管理器拖住（apk/opkg 会一直卡在 postinst）。
(
	sleep 5
	# 防重入（2026-10-22 审计）：连续装/升两个版本会叠加两个后台实例并发
	# ifup/写 UCI。stamp 新鲜（<120s）就退出，让上一棒干完。
	stamp=/var/run/mt5700-uci-defaults-post
	now=$(date +%s)
	last=$(cat "$stamp" 2>/dev/null)
	if [ -n "$last" ] && [ $((now - last)) -lt 120 ] 2>/dev/null; then
		exit 0
	fi
	echo "$now" > "$stamp" 2>/dev/null
	[ -x /etc/init.d/at-webserver ] || exit 0
	/etc/init.d/at-webserver ensure_interfaces
	/etc/init.d/at-webserver start
) >/dev/null 2>&1 &

# 让 LuCI 菜单/服务列表立刻认得这个新包的 rpcd 对象，省掉一次重新登录。
# rpcd reload 只重载 rpcd 自身，不会动到后端进程与串口。
/etc/init.d/rpcd reload >/dev/null 2>&1 || true

# ---------- 自愈巡检（cron 每 5 分钟） ----------
#
# 只做一件事：把 /etc/init.d/at-webserver selfheal --auto 挂到 cron。
# 阈值、冷却、动作边界全在 selfheal() 里（见 init.d 的注释），这里只管落地。
# 幂等：已存在就不再追加（重复安装/升级都不会堆出多条）。
if [ -f /etc/crontabs/root ] || [ -d /etc/crontabs ]; then
	mkdir -p /etc/crontabs 2>/dev/null
	touch /etc/crontabs/root 2>/dev/null
	if ! grep -q 'at-webserver selfheal --auto' /etc/crontabs/root 2>/dev/null; then
		echo '*/5 * * * * /etc/init.d/at-webserver selfheal --auto >/dev/null 2>&1' >> /etc/crontabs/root
		/etc/init.d/cron restart >/dev/null 2>&1 || true
	fi
fi

exit 0
