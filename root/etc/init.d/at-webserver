#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/at-webserver-rust
PROG_NAME="at-webserver-rust"

# 本插件写进 /etc/config/firewall 的规则名。
#
# 启动与停止必须共用这一份清单：两者各写一份时，新增规则很容易只加在一边，
# 结果 stop 漏删 —— 服务已经停了，放行 8765 的规则却还留在防火墙里。
# 真机就出现过这种情况：服务停止后 at_rpc_wan_allow 仍在 nft 规则集里。
FW_RULE_NAMES="at_webserver_wan_block at_webserver_wan_allow at_module_restrict at_module_wan_block at_module_wan_allow at_rpc_wan_allow at_rpc_wan_block"

# 加载 UCI 函数库
. /lib/functions.sh

start_service() {
	local enabled

	logger -t at-webserver "开始启动服务..."

	uci -q commit at-webserver

	config_load at-webserver
	config_get_bool enabled config enabled 0

	if [ "$enabled" -eq 0 ]; then
		logger -t at-webserver "服务已禁用，退出启动"
		echo "AT WebServer is disabled in configuration"
		return 1
	fi

	if [ ! -x "$PROG" ]; then
		logger -t at-webserver "错误：找不到可执行文件 $PROG"
		echo "Error: $PROG not found"
		return 1
	fi

	# 先清残留进程，再立刻拉起 procd，避免防火墙/串口探测拖死 start。
	# 严重警告一：这里绝不能 `killall at-webserver`——init.d 被直接执行时（开机
	# /etc/rc.d/S*、`/etc/init.d/at-webserver start`、service 命令都是直接 exec 本脚本），
	# 脚本自身的进程名(comm)就是 "at-webserver"，killall 会把脚本自己一起 SIGTERM，
	# start 会在 procd_open_instance 之前被打断（exit 143），服务永远起不来。
	#
	# 严重警告二：也绝不能 `killall at-webserver-rust`——它是 procd 托管的进程，
	# 杀掉会被 procd 记成一次「崩溃」。respawn 的重试次数用尽后
	# （默认 retry=5 / threshold=3600，即一小时内 5 次）procd 会永久放弃重启，
	# 此时实例仍然注册在 procd 里但再也不会被拉起，表现为 LuCI 提示
	# 「实例已在 procd 注册但进程未运行，可能启动失败或被反复重启」。
	# 日志特征：procd: Instance at-webserver::instance1 in a crash loop ... crashes
	# 旧实例一律交给 procd 处理（见下方实例状态自愈）。
	killall -q at-server.py 2>/dev/null

	# procd 实例自愈：
	#   已在运行       → 直接返回，避免重复拉起与竞态
	#   已注册但未运行 → 说明处于崩溃循环的「放弃态」，先摘掉注册再重新登记，
	#                    否则 start 只更新注册信息、进程永远不会被拉起
	if ubus -q call service list '{"name":"at-webserver"}' >/dev/null 2>&1; then
		if ubus -q call service list '{"name":"at-webserver"}' 2>/dev/null | grep -q '"running": true'; then
			logger -t at-webserver "服务已在运行，跳过重复启动"
			echo "AT WebServer is already running"
			return 0
		fi
		logger -t at-webserver "发现已注册但未运行的 procd 实例（崩溃循环放弃态），先清除注册状态"
		ubus call service delete '{"name":"at-webserver"}' >/dev/null 2>&1 || true
		sleep 1
	fi

	logger -t at-webserver "配置 procd 实例..."

	# ---- 时区 ----
	# Rust 侧用 chrono::Local 取本地时间，而 chrono 判定本地时区只有三条路：
	#   1) TZ 环境变量
	#   2) 把 /etc/localtime 当 TZif 文件读
	#   3) iana-time-zone 拿到时区名，再去 /usr/share/zoneinfo 读同名文件
	# OpenWrt 上后两条经常是断的 —— 本固件的 /etc/localtime 指向并不存在的
	# /tmp/localtime，zoneinfo 目录也不存在，于是 chrono 静默回落 UTC：
	# 日志、短信时间、定时锁频会整整慢一个时区（实测 Rust 日志打
	# 2026-09-13 18:39:53，同一条记录 logd 打的是 Mon Sep 14 02:39:53）。
	# busybox 的 date 不受影响，是因为它读 OpenWrt 特有的 /etc/TZ。
	# 这里把同一个值注入给子进程，chrono 就能拿到正确偏移。
	#
	# 注意：拿不到值就必须干脆不注入，绝不能注入空串 —— chrono 把空的 TZ
	# 解释为 UTC，那比不设置更糟（不设置至少还会去试 /etc/localtime）。
	local sys_tz
	sys_tz=$(cat /etc/TZ 2>/dev/null | tr -d '[:space:]')
	[ -n "$sys_tz" ] || sys_tz=$(uci -q get system.@system[0].timezone)
	[ -n "$sys_tz" ] || sys_tz=$(uci -q get system.@system[0].zonename)

	procd_open_instance
	procd_set_param command "$PROG"
	if [ -n "$sys_tz" ]; then
		procd_set_param env TZ="$sys_tz"
		logger -t at-webserver "本地时区：TZ=$sys_tz"
	else
		logger -t at-webserver "警告：未能确定系统时区，日志与定时功能将按 UTC 计"
	fi
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/at-webserver-rust.pid
	procd_close_instance

	logger -t at-webserver "服务启动配置完成"
	echo "AT WebServer started successfully"

	# 串口探测与防火墙放到后台，避免 /etc/init.d/firewall reload 阻塞 start
	( at_webserver_post_start ) >/dev/null 2>&1 &
}

at_webserver_post_start() {
	config_load at-webserver

	# 网络接口 MT5700M 的启动对齐（见下方 ensure_modem_interface 注释）
	ensure_modem_interface

	# 串口模式下尝试绑定 MT5700 USB 串口
	local conn_type
	config_get conn_type config connection_type 'SERIAL'
	if [ "$conn_type" = "SERIAL" ] && ! ls /dev/ttyUSB* >/dev/null 2>&1; then
		if command -v lsusb >/dev/null 2>&1 && lsusb -d 3466:3301 >/dev/null 2>&1; then
			modprobe usbserial 2>/dev/null || true
			modprobe option 2>/dev/null || true
			local drv new_id
			for drv in option option1 generic; do
				new_id="/sys/bus/usb-serial/drivers/$drv/new_id"
				[ -w "$new_id" ] || continue
				echo "3466 3301" > "$new_id" 2>/dev/null || continue
				sleep 1
				ls /dev/ttyUSB* >/dev/null 2>&1 && {
					logger -t at-webserver "已通过 $drv 绑定 3466:3301"
					break
				}
			done
		fi
	fi

	# 防火墙规则（RPC + 模块 AT 端口）
	local module_allow_wan restrict_module module_host module_port
	local rpc_allow_wan rpc_port
	config_get_bool module_allow_wan config network_allow_wan 0
	config_get_bool restrict_module config network_restrict_access 0
	config_get module_host config network_host '192.168.8.1'
	config_get module_port config network_port '20249'
	config_get_bool rpc_allow_wan config websocket_allow_wan 0
	config_get rpc_port config websocket_port 8765

	local rule_name rule_idx
	for rule_name in $FW_RULE_NAMES; do
		rule_idx=$(uci show firewall 2>/dev/null | grep "\.name='$rule_name'" | cut -d'[' -f2 | cut -d']' -f1 | head -n1)
		[ -n "$rule_idx" ] && uci delete firewall.@rule[$rule_idx] 2>/dev/null
	done
	uci commit firewall 2>/dev/null

	# RPC 对外监听时放行端口；否则保持无 WAN 规则（仅回环）
	if [ "$rpc_allow_wan" -eq 1 ]; then
		uci add firewall rule >/dev/null
		uci set firewall.@rule[-1].name='at_rpc_wan_allow'
		uci set firewall.@rule[-1].src='lan'
		uci set firewall.@rule[-1].dest='*'
		uci set firewall.@rule[-1].dest_port="$rpc_port"
		uci set firewall.@rule[-1].proto='tcp'
		uci set firewall.@rule[-1].target='ACCEPT'
		uci set firewall.@rule[-1].enabled='1'
		logger -t at-webserver "已允许访问 RPC 端口 $rpc_port（建议设置 auth_key）"
	fi

	if [ "$module_allow_wan" -eq 1 ]; then
		uci add firewall rule >/dev/null
		uci set firewall.@rule[-1].name='at_module_wan_allow'
		uci set firewall.@rule[-1].src='wan'
		uci set firewall.@rule[-1].dest='*'
		uci set firewall.@rule[-1].dest_ip="$module_host"
		uci set firewall.@rule[-1].dest_port="$module_port"
		uci set firewall.@rule[-1].proto='tcp'
		uci set firewall.@rule[-1].target='ACCEPT'
		uci set firewall.@rule[-1].enabled='1'
	else
		uci add firewall rule >/dev/null
		uci set firewall.@rule[-1].name='at_module_wan_block'
		uci set firewall.@rule[-1].src='wan'
		uci set firewall.@rule[-1].dest='*'
		uci set firewall.@rule[-1].dest_ip="$module_host"
		uci set firewall.@rule[-1].dest_port="$module_port"
		uci set firewall.@rule[-1].proto='tcp'
		uci set firewall.@rule[-1].target='REJECT'
		uci set firewall.@rule[-1].enabled='1'
	fi

	if [ "$restrict_module" -eq 1 ]; then
		uci add firewall rule >/dev/null
		uci set firewall.@rule[-1].name='at_module_restrict'
		uci set firewall.@rule[-1].src='lan'
		uci set firewall.@rule[-1].dest='*'
		uci set firewall.@rule[-1].dest_ip="$module_host"
		uci set firewall.@rule[-1].dest_port="$module_port"
		uci set firewall.@rule[-1].proto='tcp'
		uci set firewall.@rule[-1].target='REJECT'
		uci set firewall.@rule[-1].enabled='1'
	fi

	uci commit firewall 2>/dev/null
	# 后台 reload，避免阻塞；失败不致命
	timeout 8 /etc/init.d/firewall reload >/dev/null 2>&1 || true
	logger -t at-webserver "后台防火墙/串口初始化完成"
}

# 确保 MT5700M / MT5700Mv6 接口处于「开机自启」状态并在等待模组网口就绪后拉起。
#
# 症状（问题二）：LuCI 上模组显示在线，但「网络 → 接口」里 MT5700M 没有 IP，
# 因此上不了网。取证结果：
#   ifstatus MT5700M → "up": false, "autostart": false
# UCI 里该接口只有 device/ifname/proto/metric/defaultroute/norelease，
# 既没有 auto='1'，也没人主动 ifup，于是 netifd 从不启动它 ——
# 即使模组拨号成功、eth2 已经能 DHCP，接口也不会去要地址。
#
# 处理策略（幂等，可重复执行）：
#   1) 打开 auto='1'（开机自启），让 ifup 在模组网口就绪后自然生效；
#   2) 若接口尚未 up，调用 `ifup` 主动拉起一次；
#   3) 等待 dhcp 客户端拿到地址（最多 ~20s），拿到即结束，避免无谓等待。
# 注意：不写入 IP/网关等具体地址，全部交给 dhcp proto 协商，
# 也不改动 eth2 的设备名与 metric，保持机型定制包的定义。
ensure_modem_interface() {
	local ifname_4g='MT5700M'
	local ifname_6g='MT5700Mv6'
	local i auto_val need_commit=0

	for i in "$ifname_4g" "$ifname_6g"; do
		# 接口不存在则跳过（机型未定制该接口时不能凭空创建）
		if ! uci -q get "network.$i" >/dev/null 2>&1; then
			continue
		fi
		auto_val=$(uci -q get "network.$i.auto")
		if [ "$auto_val" != "1" ]; then
			uci -q set "network.$i.auto=1"
			need_commit=1
		fi
	done

	[ "$need_commit" -eq 1 ] && {
		uci -q commit network
		logger -t at-webserver "已将 $ifname_4g/$ifname_6g 设置为开机自启（auto=1）"
	}

	# 已经在跑就不用重复 ifup
	if ifstatus "$ifname_4g" 2>/dev/null | grep -q '"up": true'; then
		return 0
	fi

	# 模组网口可能还没枚举完成，先等设备出现（最多 15s）
	#
	# 设备名从 UCI 取，不写死 eth2：驱动/固件不同的机器上它可能叫别的名字，
	# 写死的话这里会白等满 15s，ifup 在网口就绪之前就发出去了。
	# 取不到再回退 eth2，老行为不变。device 允许是多值，只取第一个。
	local modem_dev
	modem_dev=$(uci -q get "network.$ifname_4g.device" 2>/dev/null)
	[ -n "$modem_dev" ] || modem_dev=$(uci -q get "network.$ifname_4g.ifname" 2>/dev/null)
	[ -n "$modem_dev" ] || modem_dev='eth2'
	modem_dev=${modem_dev%% *}

	local waited=0
	while [ "$waited" -lt 15 ]; do
		[ -e "/sys/class/net/$modem_dev" ] && break
		sleep 1
		waited=$((waited + 1))
	done

	ifup "$ifname_4g" >/dev/null 2>&1 || true
	ifup "$ifname_6g" >/dev/null 2>&1 || true

	# 等 DHCP 拿到地址，最多再等 20s
	waited=0
	while [ "$waited" -lt 20 ]; do
		if ifstatus "$ifname_4g" 2>/dev/null | grep -q '"up": true'; then
			logger -t at-webserver "$ifname_4g 已就绪（等待 ${waited}s 后拿到地址）"
			return 0
		fi
		sleep 2
		waited=$((waited + 2))
	done

	logger -t at-webserver "警告：$ifname_4g 仍未 up，模组网口或自动拨号可能未就绪（详见 logread -e at-webserver）"
	return 0
}

stop_service() {
	logger -t at-webserver "停止服务..."
	echo "Stopping AT WebServer..."

	# 不在此 killall：进程由 procd 托管，stop 时 procd 已按 term_timeout 发送终止信号；
	# 额外 killall 会被记成一次「崩溃」，反复 stop/start 会攒满 respawn 重试次数，
	# 最终让 procd 永久放弃重启（见 start_service 的「严重警告二」）。
	rm -f /var/run/at-webserver-rust.pid

	# 清理防火墙规则（幂等）。清单与启动时共用 FW_RULE_NAMES，避免漏删。
	for rule_name in $FW_RULE_NAMES; do
		local rule_idx=$(uci show firewall 2>/dev/null | grep "\.name='$rule_name'" | cut -d'[' -f2 | cut -d']' -f1 | head -n1)
		if [ -n "$rule_idx" ]; then
			uci delete firewall.@rule[$rule_idx] 2>/dev/null
		fi
	done
	uci commit firewall 2>/dev/null
	timeout 8 /etc/init.d/firewall reload >/dev/null 2>&1 || true
	logger -t at-webserver "已清理所有防火墙规则"

	sleep 1
	logger -t at-webserver "服务已停止"
	echo "AT WebServer stopped"
}

reload_service() {
	logger -t at-webserver "重新加载配置..."
	echo "Reloading AT WebServer configuration..."

	uci -q commit at-webserver

	# 通过 procd 重启实例，避免 killall 与 respawn 竞态导致双实例
	if ubus -q call service list '{"name":"at-webserver"}' >/dev/null 2>&1; then
		ubus call service delete '{"name":"at-webserver"}' >/dev/null 2>&1 || true
		sleep 1
	fi
	# 不 killall：先摘掉 procd 注册，旧进程的退出就不会被记成「崩溃」，
	# 也不会因为已处于崩溃循环放弃态而永远起不来。
	rm -f /var/run/at-webserver-rust.pid
	sleep 1

	start_service

	logger -t at-webserver "配置重新加载完成"
}

service_triggers() {
	procd_add_reload_trigger "at-webserver"
}
